{
  "name": "bond-issuance-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright, TypeScript, POM and Playwright-BDD framework for the Bond Issuance System",
  "scripts": {
    "test": "npm run test:bdd",
    "test:smoke": "cross-env TAGS=@smoke npm run test:bdd",
    "test:api": "cross-env TAGS=@api npm run test:bdd",
    "test:ui": "cross-env TAGS=@ui npm run test:bdd",
    "bddgen": "bddgen --config playwright.config.ts",
    "test:bdd": "npm run bddgen && playwright test -c playwright.config.ts",
    "allure:report": "allure generate reports/allure --clean -o reports/allure-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^6.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.1",
    "playwright-bdd": "^9.2.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
