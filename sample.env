# Copy to .env or select another file with ENV_FILE
ENVIRONMENT=staging
BASE_URL=http://localhost:8080
API_VERSION=v2
BUSINESS_DATE=2026-05-06
TAGS=@regression
WORKERS=1
TEST_TIMEOUT=30000
HEADLESS=true
# Comma-separated: CHROME,FIREFOX,SAFARI,IPHONE. Empty defaults to CHROME.
BROWSERS=CHROME
RUN_UI=false
SFTP_HOST=localhost
SFTP_PORT=2222
SFTP_USER=bonduser
SFTP_PASSWORD=bondpass
